# Non-secret configuration for the INDEPENDENT Medical Firebase project.
MEMBER_ACCESS_POLICY=all_registered
MEMBER_ALLOWED_STATES=[]
MYNEKABA_ADMIN_ACCOUNT_IDS=replace-with-approved-account-document-id
MYNEKABA_AUTH_API_KEY=replace-with-source-firebase-web-api-key
MEDICAL_ALLOWED_ORIGINS=https://abomawadda.github.io,https://medical-nekaba.vercel.app

# Configure via Firebase Secret Manager, never here or in Git:
# MEDICAL_SESSION_SECRET: random value >=32 characters
# MYNEKABA_READONLY_CREDENTIALS: dedicated read-only source service-account JSON
