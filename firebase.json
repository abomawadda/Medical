{
  "functions": [
    {
      "source": "functions",
      "codebase": "medical",
      "predeploy": [
        "node scripts/assert-medical-project.mjs",
        "node scripts/prepare-seed.mjs"
      ],
      "ignore": ["node_modules", "test", ".env*", "*.log"]
    }
  ],
  "firestore": {
    "rules": "firebase/medical.firestore.rules",
    "predeploy": ["node scripts/assert-medical-project.mjs"]
  },
  "emulators": {
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "ui": { "enabled": false }
  }
}
